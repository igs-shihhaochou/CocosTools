{
  "extends": [
    "./temp/tsconfig.cocos.json",
    "./node_modules/gts/tsconfig-google.json"
  ],
  "compilerOptions": {
    "module": "commonjs",
    "lib": ["es2015", "es2017", "dom"],
    "target": "es6",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "outDir": "temp/vscode-dist",
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "allowJs": true
  },
  "exclude": [
    "node_modules",
    "library",
    "local",
    "temp",
    "build",
    "settings",
    "extensions"
  ]
}
